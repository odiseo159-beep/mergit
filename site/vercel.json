{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mergit-nine.vercel.app"
        }
      ],
      "destination": "https://www.mergit.xyz/$1",
      "permanent": true
    },
    {
      "source": "/claim",
      "destination": "/register",
      "permanent": true
    },
    {
      "source": "/claim.html",
      "destination": "/register",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/record/:file",
      "destination": "/api/record?file=:file"
    },
    {
      "source": "/p/:login",
      "destination": "/p?login=:login"
    },
    {
      "source": "/badge/:file",
      "destination": "/api/badge?file=:file"
    },
    {
      "source": "/card/:file",
      "destination": "/api/badge?file=:file&style=card"
    }
  ]
}
